[Unit]
Description=Tailscale Sidecar for Velocity Ingress

[Container]
Image=docker.io/tailscale/tailscale:latest
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
Environment=TS_USERSPACE=false
Environment=TS_HOSTNAME=mc-velocity
Environment=TS_AUTH_ONCE=true
Environment=TS_EXTRA_ARGS=--login-server=@TS_LOGIN_SERVER@
EnvironmentFile=@TS_SECRET_PATH@
Environment=TS_STATE_DIR=/var/lib/tailscale
Volume=mc-velocity_tailscale_state:/var/lib/tailscale:Z
Network=cluster.network
PodmanArgs=--replace

PublishPort=25565:25565/tcp
PublishPort=19132:19132/udp
PublishPort=24454:24454/udp

[Install]
WantedBy=default.target
