[Unit]
Description=Minecraft Velocity Proxy
Requires=@APP_NAME@-tailscale.service
After=@APP_NAME@-tailscale.service

[Container]
Image=docker.io/itzg/mc-proxy:latest
Environment=TYPE=VELOCITY
Environment=MEMORY=512M
Environment=REPLACE_ENV_VARIABLES=true

Volume=%h/.config/velocity:/config:ro
Volume=@FORWARDING_SECRET_PATH@:/config/forwarding.secret:ro
Volume=mc-velocity_server:/server:Z

Network=@APP_NAME@-tailscale.container

PodmanArgs=--replace

[Install]
WantedBy=default.target
