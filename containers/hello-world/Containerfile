FROM docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder
RUN apk add --no-cache git
WORKDIR /app

ARG COMMIT_HASH

# 指定されたコミットとパスからソースを取得
RUN git clone https://github.com/vercel/next.js.git . && \
    git checkout $COMMIT_HASH

WORKDIR /app/examples/hello-world
RUN npm install
RUN npm run build

# 実行ステージ
FROM docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner
WORKDIR /app
ENV NODE_ENV production
COPY --from=builder /app/examples/hello-world/.next ./.next
COPY --from=builder /app/examples/hello-world/node_modules ./node_modules
COPY --from=builder /app/examples/hello-world/package.json ./package.json

EXPOSE 3000
CMD ["npm", "start"]
