[Unit]
Description=Hello World (Next.js) Application
Requires=hello-world.image.service
After=hello-world.image.service
Requires=hello-world-tailscale.service
After=hello-world-tailscale.service

[Container]
Image=localhost/hello-world:@COMMIT_HASH@
EnvironmentFile=@SECRETS_PATH@
Network=container:hello-world-tailscale

[Install]
WantedBy=default.target
