[Unit]
Description=JPost API Server
Requires=jpost-api-build.service
After=jpost-api-build.service
Requires=jpost-api-tailscale.service
After=jpost-api-tailscale.service

[Container]
Image=localhost/jpost-api
EnvironmentFile=@SECRETS_PATH@
Network=jpost-api-tailscale.container
PodmanArgs=--replace

[Install]
WantedBy=default.target
