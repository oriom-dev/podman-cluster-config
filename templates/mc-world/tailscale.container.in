[Unit]
Description=Tailscale Sidecar for Minecraft @SERVER_NAME@

[Container]
Image=docker.io/tailscale/tailscale:latest
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
Environment=TS_USERSPACE=false
Environment=TS_HOSTNAME=mc-@SERVER_NAME@
Environment=TS_EXTRA_ARGS=--login-server=@TS_LOGIN_SERVER@
EnvironmentFile=@TS_SECRET_PATH@
Environment=TS_STATE_DIR=/var/lib/tailscale
Volume=mc_@SERVER_NAME@_ts_state:/var/lib/tailscale:Z
Network=cluster.network
PodmanArgs=--replace

[Install]
WantedBy=default.target
