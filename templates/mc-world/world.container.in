[Unit]
Description=Minecraft Server (@SERVER_NAME@)
Requires=mc-@SERVER_NAME@-tailscale.service
After=mc-@SERVER_NAME@-tailscale.service

[Container]
Image=docker.io/itzg/minecraft-server:latest
Volume=mc-@SERVER_NAME@_data:/data:Z

@PATCH_VOLUMES@

Network=container:systemd-mc-@SERVER_NAME@-tailscale
PodmanArgs=--replace

EnvironmentFile=@COMMON_SECRETS_PATH@
@WORLD_SECRETS_PATHES@

Environment=EULA=TRUE
Environment=TYPE=PAPER
Environment=ENABLE_RCON=true
Environment=ONLINE_MODE=false

Environment=PATCH_DEFINITIONS=@PATCH_DEFINITIONS@

Environment=VERSION=26.1.1

@EXTRA_ENV@

[Install]
WantedBy=default.target
