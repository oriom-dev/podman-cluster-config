[Unit]
Description=Tailscale Sidecar for @APP_NAME@

[Container]
Image=docker.io/tailscale/tailscale:latest
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
Environment=TS_USERSPACE=false
Environment=TS_HOSTNAME=@APP_NAME@
Environment=TS_AUTH_ONCE=true
Environment=TS_EXTRA_ARGS=--login-server=https://headscale.oriom.dev
EnvironmentFile=@TS_SECRET_PATH@
Volume=%h/.local/share/tailscale/@APP_NAME@:/var/lib/tailscale:Z
Network=cluster.network
PodmanArgs=--replace

[Install]
WantedBy=default.target
