[Unit]
Description=Tailscale Sidecar for @APP_NAME@

[Container]
Image=docker.io/tailscale/tailscale:latest
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
Environment=TS_USERSPACE=false
Environment=TS_EXTRA_ARGS=--login-server=https://headscale.oriom.dev --hostname=@APP_NAME@
EnvironmentFile=@TS_SECRET_PATH@
Volume=@APP_NAME@_tailscale_state:/var/lib/tailscale:Z
Network=cluster.network
PodmanArgs=--replace

[Install]
WantedBy=default.target
